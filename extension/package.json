{
  "name": "inflate",
  "displayName": "Inflate",
  "description": "Faithful Android layout & drawable XML previews in VS Code, powered by layoutlib.",
  "version": "0.0.1",
  "publisher": "inflate",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:inflate.helloPreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inflate.helloPreview",
        "title": "Inflate: Hello Preview (M0)"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest:integration": "npm run build && npm run compile-tests",
    "test": "vitest run",
    "test:integration": "node ./out/test/integration/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "mocha": "^10.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
