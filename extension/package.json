{
  "name": "inflate",
  "displayName": "Inflate",
  "description": "Faithful Android layout & drawable XML previews in VS Code, powered by layoutlib.",
  "version": "0.0.1",
  "publisher": "inflate",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:inflate.openPreview",
    "onCommand:inflate.refreshPreview",
    "onCommand:inflate.doctor",
    "onCommand:inflate.clearEngineCache",
    "onCommand:inflate.restartHost"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inflate.openPreview",
        "title": "Inflate: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "inflate.refreshPreview",
        "title": "Inflate: Refresh Preview"
      },
      {
        "command": "inflate.doctor",
        "title": "Inflate: Doctor"
      },
      {
        "command": "inflate.clearEngineCache",
        "title": "Inflate: Clear Engine Cache"
      },
      {
        "command": "inflate.restartHost",
        "title": "Inflate: Restart Render Host"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "inflate.openPreview",
          "when": "inflate:eligibleDocument",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "inflate.openPreview",
          "when": "inflate:eligibleDocument"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 && esbuild webview-ui/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2020",
    "compile-tests": "rm -rf out && tsc -p tsconfig.test.json",
    "pretest:integration": "npm run build && npm run compile-tests",
    "test": "vitest run",
    "test:integration": "node ./out/test/integration/runTest.js"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "mocha": "^10.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "vscode-jsonrpc": "^9.0.1"
  }
}
