<?xml version="1.0" encoding="utf-8"?>
<!-- Semantically identical to gradle-sample's app/src/main/res/layout/main.xml, but stored with
     legacy Xamarin casing (Resources/Layout/Main.axml) and the .axml extension (Q6). The resolver
     matches the resource-type dir case-insensitively and accepts .axml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/pad">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        style="@style/Body"
        android:text="@string/hello" />

    <View
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/box" />
</FrameLayout>
