<?xml version="1.0" encoding="utf-8"?>
<!-- §FR-3 animated type <animation-list> (AnimationDrawable): frame 0 + static badge (T46). -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
  <item android:duration="150">
    <shape android:shape="rectangle"><solid android:color="#FFFF0000" /></shape>
  </item>
  <item android:duration="150">
    <shape android:shape="rectangle"><solid android:color="#FF00FF00" /></shape>
  </item>
  <item android:duration="150">
    <shape android:shape="rectangle"><solid android:color="#FF0000FF" /></shape>
  </item>
</animation-list>
