<?xml version="1.0" encoding="utf-8"?>
<!-- §FR-3 <layer-list>: full compositing incl. per-item insets, width/height and gravity. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle"><solid android:color="@color/gallery_primary" /></shape>
  </item>
  <item
      android:left="12dp"
      android:top="12dp"
      android:right="12dp"
      android:bottom="12dp">
    <shape android:shape="oval"><solid android:color="@color/gallery_surface" /></shape>
  </item>
  <item
      android:width="24dp"
      android:height="24dp"
      android:gravity="center">
    <shape android:shape="rectangle"><solid android:color="@color/gallery_accent" /></shape>
  </item>
</layer-list>
