<?xml version="1.0" encoding="utf-8"?>
<!-- §FR-3 <level-list>: level 5000 selects the item whose [minLevel,maxLevel] contains it (T46). -->
<level-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:minLevel="0" android:maxLevel="4999" android:drawable="@drawable/shape_oval" />
  <item android:minLevel="5000" android:maxLevel="10000" android:drawable="@drawable/clip_child" />
</level-list>
