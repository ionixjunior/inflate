<?xml version="1.0" encoding="utf-8"?>
<!-- LAY-07: the AdapterView trio (ListView, GridView, ExpandableListView) rendered empty at their
     correct bounds (no adapter/items in v1; tools:listitem is P2-M). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ListView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFF0F0F0" />

    <GridView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:background="#FFE8E8FF" />

    <ExpandableListView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFE8FFE8" />
</LinearLayout>
