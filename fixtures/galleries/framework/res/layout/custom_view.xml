<?xml version="1.0" encoding="utf-8"?>
<!-- P1-A AC5: a custom/unknown view class. The Preprocessor (UnknownViewSubstitutor / Scan)
     substitutes it with a labeled TextView placeholder and records a substitutedClass warning. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Above the custom view" />

    <com.example.FakeView
        android:layout_width="match_parent"
        android:layout_height="120dp" />

    <view
        class="com.example.OtherFakeView"
        android:layout_width="match_parent"
        android:layout_height="80dp" />
</LinearLayout>
