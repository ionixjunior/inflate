<?xml version="1.0" encoding="utf-8"?>
<!-- P1-A AC4: a merge root. The Preprocessor wraps it in a match_parent FrameLayout.
     (Comments here avoid tag-like text: the Phase 5 preprocessor is regex-based, not
     comment-aware, so a literal merge/layout/include tag in a comment would be rewritten too.) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="First merged child" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Second merged child"
        android:background="#FFCCE5FF" />
</merge>
