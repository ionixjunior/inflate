<?xml version="1.0" encoding="utf-8"?>
<!-- Rendered with an oversized device config in the test to exercise the 4096x4096 canvas cap
     (clip + canvasCapped notice). The content itself is a plain match_parent fill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF2277DD">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Oversize canvas"
        android:textColor="@android:color/white" />
</LinearLayout>
