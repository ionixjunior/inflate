<?xml version="1.0" encoding="utf-8"?>
<!-- LAY-08 edge case: tools:layout_height overrides the root's real layout_height. Without the
     override, wrap_content would measure to the 50dp child; the promoted 150dp value must govern
     instead (ToolsAttributes promotes tools:layout_height -> android:layout_height, T90). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:layout_height="150dp"
    android:background="#FF224488">

    <View
        android:layout_width="50dp"
        android:layout_height="50dp" />
</FrameLayout>
