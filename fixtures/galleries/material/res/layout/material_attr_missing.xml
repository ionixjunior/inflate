<?xml version="1.0" encoding="utf-8"?>
<!--
  P1-B AC4: a MaterialButton that uses a real bundled attribute (app:cornerRadius, defined by Material
  1.12.0) plus a fabricated one (app:madeUpMaterialAttr) that the bundled version does NOT define. The
  render must succeed with the unknown attribute ignored, and emit exactly one materialAttrMissing
  warning naming that attribute and the bundled Material version.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/probe_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Probe"
        app:cornerRadius="8dp"
        app:madeUpMaterialAttr="nope"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
