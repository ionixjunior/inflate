<?xml version="1.0" encoding="utf-8"?>
<!-- LAY-08 AC7 shape (b): the second reported layout shape — a child constrained
     top_toBottomOf a sibling AND bottom_toBottomOf="parent" must sit directly below the sibling
     inside the wrapped bounds, not float centered in the stretched device space (the reported
     defect). Root is match_parent x wrap_content. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF224488">

    <View
        android:id="@+id/sibling_a"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#FFDD3311"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/bottom_child_b"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#FF33AA55"
        app:layout_constraintTop_toBottomOf="@id/sibling_a"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
