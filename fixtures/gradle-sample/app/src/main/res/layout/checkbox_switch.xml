<?xml version="1.0" encoding="utf-8"?>
<!-- T55 corpus fixture: CheckBox/Switch/RadioGroup (§FR-1 widgets). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/pad"
    android:background="@color/background">

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enabled" />

    <Switch
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On" />

    <RadioGroup
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A" />
        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B" />
    </RadioGroup>
</LinearLayout>
